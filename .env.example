APP_ENV=development
APP_NAME=Oficina AI
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql+psycopg://oficina:oficina@localhost:5432/oficina
REDIS_URL=redis://localhost:6379/0

LLM_ENABLED=false
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

MEMORY_MODE=true
MEMORY_TTL_SECONDS=604800
MAX_CONTEXT_CHUNKS=6
UPLOAD_MAX_MB=15

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AI_ASK_MAX=20
RATE_LIMIT_AI_ASK_WINDOW_SECONDS=60
RATE_LIMIT_RAG_INGEST_MAX=10
RATE_LIMIT_RAG_INGEST_WINDOW_SECONDS=60

RAG_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,txt

# FASE 1 — autenticação por sessão (cookie + Redis) e RBAC
SESSION_COOKIE_NAME=session_id
SESSION_TTL_SECONDS=28800
# Em produção deixe true (exige HTTPS). Em dev local sem HTTPS, mantenha false.
SESSION_COOKIE_SECURE=false
PASSWORD_HASH_ITERATIONS=600000

# Seed do usuário administrador inicial (rodar `python -m app.db.seed`).
# Deixe em branco para não semear nada.
SEED_COMPANY_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# FASE 4/5 — notificações (comprovante de OS e alerta de revisão).
# Deixe em branco para não enviar de verdade — o envio fica como SKIPPED no
# log (ver app/services/notifications.py), sem quebrar o fechamento da OS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@oficina.local
SMTP_USE_TLS=true

WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_FROM_NUMBER=

# Quantos dias antes do vencimento da próxima revisão o lembrete é disparado.
REVISION_REMINDER_DAYS_AHEAD=7

# FASE 10 — retenção de dados (LGPD, princípio de minimização, art. 6º VII).
RETENTION_NOTIFICATION_LOGS_DAYS=180
RETENTION_INACTIVE_CUSTOMER_YEARS=5
